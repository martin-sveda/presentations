{
  "name": "2026-12-02-ai-lessons",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm run build-base && pnpm run export-pdf",
    "build-base": "slidev build --base /presentations/",
    "dev": "slidev --open",
    "preview": "vite preview --base /presentations/",
    "export": "slidev export --per-slide --wait-until networkidle --wait 1000",
    "export-pdf": "mkdir -p dist && pnpm run export --output dist/2026-12-02-ai-lessons.pdf",
    "test": "node --test scripts/bottleneck.test.mjs scripts/delivery-flow.test.mjs components/copilot-chat/scripts/*.test.mjs",
    "test:pdf": "node --test scripts/export-pdf.test.mjs",
    "deploy": "pnpm run build && pnpm run test:pdf && gh-pages -d dist --branch gh-pages --no-history --nojekyll"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.6",
    "@iconify-json/carbon": "^1.2.14",
    "@iconify-json/devicon": "^1.2.45",
    "@iconify-json/fluent": "^1.2.33",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/logos": "^1.2.9",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.6",
    "@iconify-json/simple-icons": "^1.2.55",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/twemoji": "^1.2.4",
    "@iconify/utils": "^3.0.2",
    "@slidev/cli": "52.5.0",
    "@slidev/client": "52.5.0",
    "@slidev/theme-default": "0.25.0",
    "@vueuse/core": "13.9.0",
    "gh-pages": "^6.3.0",
    "playwright-chromium": "1.56.1",
    "seedrandom": "^3.0.5",
    "unocss": "^66.5.4",
    "vite": "^6.4.1",
    "vue": "^3.5.22"
  }
}
